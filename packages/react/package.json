{
  "name": "@mab-kit/react",
  "version": "0.1.1",
  "description": "React hooks for mab-kit: read PostHog-driven bandit variants and report conversions",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "tsup",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "posthog-js": ">=1.150.0",
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.0.0",
    "jsdom": "^25.0.1",
    "posthog-js": "^1.200.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "keywords": ["react", "posthog", "feature-flags", "multi-armed-bandit", "ab-testing"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CraftsManShip001/mab-kit.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/CraftsManShip001/mab-kit#readme",
  "bugs": "https://github.com/CraftsManShip001/mab-kit/issues"
}
