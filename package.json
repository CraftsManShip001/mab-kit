{
  "name": "mab-kit",
  "version": "0.0.0",
  "private": true,
  "description": "Multi-Armed Bandit (Thompson Sampling) experimentation toolkit, powered by PostHog",
  "type": "module",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build",
    "test": "pnpm -r --filter \"./packages/*\" test",
    "typecheck": "pnpm -r --filter \"./packages/*\" typecheck",
    "clean": "pnpm -r exec rm -rf dist",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.10",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "packageManager": "pnpm@10.18.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CraftsManShip001/mab-kit.git"
  },
  "homepage": "https://github.com/CraftsManShip001/mab-kit#readme",
  "bugs": "https://github.com/CraftsManShip001/mab-kit/issues",
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
